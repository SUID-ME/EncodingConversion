<Window x:Class="EncodingConversion.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EncodingConversion.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="150" Width="800"
        MinHeight="150" MinWidth="800"
        >
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="Output" Background="White" Margin="1" 
                       HorizontalAlignment="Stretch"
                       FontSize="16" TextWrapping="Wrap" VerticalAlignment="Stretch"/>
            <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" Margin="1"
                    Click="FolderChoose_Click" FontSize="24"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button x:Name="ConvertButton" Content="Convert" Click="Convert_Click" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
