<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:EncodingConversion.AvaloniaUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="500"
             x:Class="EncodingConversion.AvaloniaUI.Views.RecodingView"
			 x:DataType="vm:RecordingVM">
	<Design.DataContext>
		<vm:RecordingVM/>
	</Design.DataContext>

	<Grid Background="SlateGray">
		<Grid.RowDefinitions>
			<RowDefinition Height="20*" MaxHeight="60"/>
			<RowDefinition Height="80*"/>
		</Grid.RowDefinitions>

		<!--#region OutputAndFilePick-->
		<Grid Grid.Column="0" Grid.Row="0" Margin="5" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="92*"/>
				<ColumnDefinition Width="8*"/>
			</Grid.ColumnDefinitions>

			<Border CornerRadius="5" BorderBrush="DimGray" Background="LightGray" BorderThickness="1.4">
				<TextBlock Grid.Column="0" Text="{Binding OutPutText}" Margin="3" VerticalAlignment="Center"
					FontSize="16" TextWrapping="Wrap"/>
			</Border>
			<Button Command="{Binding PickRootDirAsync}"
				Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" FontSize="30"
				HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
		</Grid>
		<!--#endregion OutputAndFilePick-->

		<!--#region Options-->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="80*"/>
				<ColumnDefinition Width="20*" MaxWidth="90"/>
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

				<!--#region ExtensionsList-->
				<Border Grid.Column="0" Background="DimGray"
						CornerRadius="5" Margin="5">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>

						<Grid.RowDefinitions>
							<RowDefinition Height="10*" MaxHeight="50"/>
							<RowDefinition Height="90*"/>
						</Grid.RowDefinitions>

						<Border Background="DarkGray" Margin="5" CornerRadius="5">
							<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
								<CheckBox Margin="17, 0" IsChecked="{Binding IsCheckedAllEnable}" 
										  Command="{Binding EnableOrDisableAllExtensionsCommand}"/>
								<TextBlock Text="Вкл/Выкл все" VerticalAlignment="Center" FontSize="16"/>
							</StackPanel>
						</Border>
						
						<Border Grid.Row="1" Grid.Column="0" CornerRadius="10"
								BorderThickness="4" BorderBrush="DimGray" Background="DarkGray">
							<ListBox ItemsSource="{Binding ExtensionInfos}"
									 SelectedItem="{Binding SelectedExtension}" 
									 BackgroundSizing="InnerBorderEdge"
									 Background="Transparent" MinWidth="15">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Background="SlateGray" CornerRadius="10" 
												BorderBrush="DimGray" BorderThickness="2">
											<StackPanel Orientation="Horizontal" Margin="5" Spacing="10">
												<CheckBox IsChecked="{Binding IsEnable}" Content="Вкл"/>
												<TextBox Text="{Binding Symbols}" FontSize="18"/>
											</StackPanel>
										</Border>

									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Border>

						<StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" Spacing="3" Margin="5">
							<Button Content="Добавить расширение" Command="{Binding AddExtensionCommand}"
									Background="LightGray" BorderThickness="1" BorderBrush="Black" 
									HorizontalAlignment="Stretch"/>
							<Button Content="Убрать расширение" Command="{Binding RemoveSelectedExtCommand}"
									Background="LightGray" BorderThickness="1" BorderBrush="Black" 
									HorizontalAlignment="Stretch"/>
							<Button Content="Очистить список" Command="{Binding ClearExtensionsCommand}"
									Background="LightGray" BorderThickness="1" BorderBrush="Black"
									HorizontalAlignment="Stretch"/>
							<Button Content="Убрать выключенные расширения" Command="{Binding ClearDisabladExtensionsCommand}"
									Background="LightGray" BorderThickness="1" BorderBrush="Black"
									HorizontalAlignment="Stretch"/>
							<Button Content="Определить расширения" Command="{Binding LocateExtensionsCommand}"
									Background="LightGray" BorderThickness="1" BorderBrush="Black"
									HorizontalAlignment="Stretch"/>
						</StackPanel>
					</Grid>
				</Border>
				<!--#endregion ExtensionsList-->

				<!-- #region Properties -->

				<!-- #endregion Properties -->
			</Grid>


			<!--#region MainButtons-->
			<Grid Grid.Column="1" Margin="5">
				<Button Command="{Binding RecodingCommand}" Content="Начать" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Right"/>
			</Grid>
			<!--#endregion MainButtons-->
		</Grid>
		<!--#endregion Options-->
	</Grid>
</UserControl>
